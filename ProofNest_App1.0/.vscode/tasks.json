{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ProofNest: Setup Android platform",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1"],
      "problemMatcher": []
    },
    {
      "label": "ProofNest: Get packages",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "problemMatcher": []
    },
    {
      "label": "ProofNest: Analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "problemMatcher": "$dart-analyzer"
    },
    {
      "label": "ProofNest: Test",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "problemMatcher": []
    }
  ]
}
